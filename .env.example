# Gemini API Key (Required for AI meal analysis)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Optional, default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Twilio WhatsApp Configuration (Optional - for direct WhatsApp summaries)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Twilio Content Template SID (Optional - if using approved WhatsApp Content Template)
TWILIO_CONTENT_SID=your_content_template_sid_here
