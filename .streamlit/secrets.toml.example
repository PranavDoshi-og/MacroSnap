# Gemini API Key (Required)
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY = "your-gemini-api-key-here"

# Model Selection (Optional, default is gemini-2.5-flash)
GEMINI_MODEL = "gemini-2.5-flash"

# Twilio WhatsApp Configuration (Optional - leave blank if not sending via WhatsApp API)
TWILIO_ACCOUNT_SID = "your-twilio-account-sid-here"
TWILIO_AUTH_TOKEN = "your-twilio-auth-token-here"
# Twilio Sandbox shared WhatsApp number
TWILIO_WHATSAPP_FROM = "whatsapp:+14155238886"
# Content SID (HX...) of your WhatsApp Content Template (Optional)
TWILIO_CONTENT_SID = ""
